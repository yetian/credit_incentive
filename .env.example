# Server
PORT=3000

# Auth (long-lived token, password-less tenant switching)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=3650d

# SQLite
DB_PATH=./data/credit_incentive.db

# Savings compound engine
SAVINGS_ANNUAL_RATE=0.12
SAVINGS_PERIODS_PER_YEAR=52

# Loan engine
LOAN_ANNUAL_RATE=0.18
LOAN_PERIODS_PER_YEAR=52
LOAN_CREDIT_PER_SCORE=0.5
LOAN_DEFAULT_PENALTY=50
CREDIT_SCORE_MIN=0
CREDIT_SCORE_MAX=1000

# Gamification
BADGE_REWARD=10
CONTRACTOR_MIN_PROPOSALS=1
CONTRACTOR_MIN_ASSETS=1
CEO_MIN_REPAID_LOANS=1
CEO_MIN_SAVINGS=100
CEO_MIN_CREDIT_SCORE=700

# Scheduler (weekly compound + loan interest + overdue check)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=3600000
