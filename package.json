{
  "name": "credit-incentive",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified check-in & micro-economy decision backend (Employee -> CEO)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/db/seed.ts",
    "db:reset": "ts-node src/db/reset.ts",
    "test": "vitest run",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "build:all": "npm run build && npm run web:build"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
